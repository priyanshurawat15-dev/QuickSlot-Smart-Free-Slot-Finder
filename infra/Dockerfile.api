FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY apps/api/pom.xml ./pom.xml
RUN mvn -B dependency:go-offline
COPY apps/api/src ./src
RUN mvn -B -DskipTests package
FROM eclipse-temurin:21-jre
WORKDIR /app
RUN groupadd --system quickslot && useradd --system --gid quickslot quickslot
COPY --from=build /workspace/target/quickslot-api-0.1.0.jar /app/quickslot.jar
USER quickslot
EXPOSE 8000
ENTRYPOINT ["java", "-jar", "/app/quickslot.jar"]
